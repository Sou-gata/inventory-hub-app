<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vertical guide rail from top through bottom connecting under Purchase icon -->
    <item
        android:left="35dp"
        android:width="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/border" />
        </shape>
    </item>

    <!-- Horizontal branch arm (├──) connecting rail to the submenu pill -->
    <item
        android:left="35dp"
        android:width="12dp"
        android:top="19dp"
        android:bottom="19dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/border" />
        </shape>
    </item>

    <!-- Nested submenu clickable pill -->
    <item
        android:left="44dp"
        android:right="12dp"
        android:top="2dp"
        android:bottom="2dp">
        <ripple android:color="@color/focus_ring_teal">
            <item>
                <selector>
                    <item android:state_checked="true">
                        <shape android:shape="rectangle">
                            <corners android:radius="10dp" />
                            <solid android:color="@color/card2" />
                            <stroke
                                android:width="1dp"
                                android:color="@color/accent_teal" />
                        </shape>
                    </item>
                    <item android:state_pressed="true">
                        <shape android:shape="rectangle">
                            <corners android:radius="10dp" />
                            <solid android:color="@color/card2" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="@android:color/transparent" />
                        </shape>
                    </item>
                </selector>
            </item>
        </ripple>
    </item>
</layer-list>
