<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".activities.ScannerActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/scannerPreviewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <in.gbtsolutions.inventoryhub.views.ScannerOverlayView
        android:id="@+id/scannerOverlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Bar with Back, Title & Flash -->
    <LinearLayout
        android:id="@+id/scanner_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_scanner_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_scanner_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="@string/scan_qr_code"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/btn_scanner_flash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Flash"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_flash_off"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Bottom Controls with Mode Switcher & Hint -->
    <LinearLayout
        android:id="@+id/scanner_bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Instruction Hint -->
        <TextView
            android:id="@+id/tv_scanner_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_status_chip"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/align_qr_hint"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <!-- Segmented Mode Switcher (QR Code / Barcode) -->
        <LinearLayout
            android:id="@+id/container_mode_tabs"
            android:layout_width="260dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_scan_qr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_status_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text="@string/code_format_qr"
                android:textColor="@color/material_blue"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tab_scan_barcode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/code_format_barcode"
                android:textColor="@color/fg_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
