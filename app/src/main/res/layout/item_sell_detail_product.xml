<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_search_box"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Row 1: Product Name & Line Total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_item_product_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/fg"
            android:textSize="14sp"
            tools:text="Wireless Mechanical Keyboard RGB" />

        <TextView
            android:id="@+id/text_item_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/accent_teal"
            android:textSize="14sp"
            tools:text="₹ 4,999.00" />
    </LinearLayout>

    <!-- Row 2: SKU and Qty x Unit Price -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_item_sku"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_sku"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/fg_dim"
            android:textSize="10sp"
            tools:text="SKU: KB-9812" />

        <TextView
            android:id="@+id/text_item_batch_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_badge_qty"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/accent_teal"
            android:textSize="10sp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Batch: BN-26259-001" />

        <TextView
            android:id="@+id/text_item_qty_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:textColor="@color/fg_dim"
            android:textSize="12sp"
            tools:text="Qty: 2 × ₹ 2,200.00" />
    </LinearLayout>

    <!-- Row 3: Tax & Discount Details -->
    <LinearLayout
        android:id="@+id/layout_item_tax_discount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_item_tax_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:textColor="@color/fg_dim"
            android:textSize="11sp"
            tools:text="GST: 18% (₹ 396.00)" />

        <TextView
            android:id="@+id/text_item_discount_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/accent_teal"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Discount: ₹ 200.00"
            tools:visibility="visible" />
    </LinearLayout>

</LinearLayout>
