<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_batch_select_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/card"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_select_batch_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/fg"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="BN-26259-001" />

                <TextView
                    android:id="@+id/tv_select_batch_expired_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_expired"
                    android:text="EXPIRED"
                    android:textColor="@color/error_red"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_select_batch_avail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fg_dim"
                    android:textSize="12sp"
                    tools:text="Avail: 15" />

                <TextView
                    android:id="@+id/tv_select_batch_expiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/fg_dim"
                    android:textSize="12sp"
                    tools:text="Exp: 10/11/26" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_select_batch_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/accent_teal"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="₹150.00 / unit" />
        </LinearLayout>

        <!-- Stepper Controls: Minus, Qty, Plus -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_qty_minus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Decrease quantity"
                android:src="@drawable/ic_minus"
                app:tint="@color/fg_muted" />

            <EditText
                android:id="@+id/et_select_qty"
                android:layout_width="wrap_content"
                android:minWidth="56dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="2dp"
                android:paddingHorizontal="4dp"
                android:background="@drawable/bg_field_normal"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:text="0"
                android:textColor="@color/fg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_qty_plus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Increase quantity"
                android:src="@drawable/ic_add"
                app:tint="@color/accent_teal" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
