<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialog_batch_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/fg"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Add Batch" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp"
        android:textColor="@color/fg_dim"
        android:textSize="12sp"
        android:text="Enter batch number, quantity, price, and expiration date" />

    <!-- Batch Number Input with Auto-generate / Clear -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_batch_no"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:hint="Batch No (e.g. BN-26259-001)"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_batch_no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:textColor="@color/fg" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <!-- Quantity -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_batch_qty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:hint="Quantity *">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_batch_qty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/fg" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Expiry Date -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_batch_expiry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:hint="Expiry Date"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_batch_expiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:textColor="@color/fg" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <!-- Purchase Price / Cost -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_batch_purchase_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:hint="Cost Price (₹)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_batch_purchase_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="@color/fg" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Selling Price (Optional batch override) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_batch_selling_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:hint="Selling Price (₹)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_batch_selling_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="@color/fg" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_batch"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textColor="@color/fg_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_batch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/accent_teal"
            android:text="Add Batch"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
