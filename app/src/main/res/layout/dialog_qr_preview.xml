<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="24dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_tag_sku" />

    <!-- Dialog Header -->
    <TextView
        android:id="@+id/tv_preview_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="QR Code Generated"
        android:textColor="@color/fg"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/tv_preview_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif"
        android:text="Saved to Downloads folder"
        android:textColor="@color/status_green"
        android:textSize="12sp" />


    <!-- Details Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_field_normal"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_preview_product_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/fg"
            android:textSize="14sp"
            tools:text="Paracetamol 500mg Tablet" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_preview_product_sku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_sku"
                android:fontFamily="monospace"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/fg_muted"
                android:textSize="11sp"
                tools:text="#MED-0042" />

            <TextView
                android:id="@+id/tv_preview_product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/accent_teal"
                android:textSize="12sp"
                tools:text="₹ 45.00" />
        </LinearLayout>

        <!-- Batch & Expiry Row (Hidden if no batch is present) -->
        <LinearLayout
            android:id="@+id/container_preview_batch_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="6dp"
                android:background="@color/border" />

            <TextView
                android:id="@+id/tv_preview_batch_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textColor="@color/fg_muted"
                android:textSize="12sp"
                tools:text="Batch: BN-26259-001 • Exp: 24/12/2026" />
        </LinearLayout>

        <!-- Copies count summary -->
        <TextView
            android:id="@+id/tv_preview_copies_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/fg_dim"
            android:textSize="11sp"
            tools:text="Copies saved: 1" />
    </LinearLayout>

    <!-- Dialog Actions: Share and Done -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share_qr"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Share"
            android:textColor="@color/fg"
            app:cornerRadius="12dp"
            app:strokeColor="@color/border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_done_qr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/accent_teal"
            android:text="Done"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
