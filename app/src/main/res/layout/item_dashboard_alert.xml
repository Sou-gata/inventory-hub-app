<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:paddingHorizontal="14dp">

    <!-- Alert Icon Badge -->
    <FrameLayout
        android:id="@+id/container_alert_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_stock_low">

        <ImageView
            android:id="@+id/iv_alert_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_error"
            app:tint="@color/status_orange" />
    </FrameLayout>

    <!-- Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_alert_product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textSize="14sp"
            tools:text="Logitech MX Master 3S" />

        <TextView
            android:id="@+id/tv_alert_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/fg_dim"
            android:textSize="12sp"
            tools:text="SKU: LOGI-MX3 • Electronics" />
    </LinearLayout>

    <!-- Stock level indicator -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_alert_stock_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stock_low"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/status_orange"
            android:textSize="11sp"
            tools:text="2 left" />

        <TextView
            android:id="@+id/tv_alert_reorder_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/fg_dim"
            android:textSize="11sp"
            tools:text="Reorder at: 10" />
    </LinearLayout>

</LinearLayout>
