<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card2"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Row 1: Product Name & Status / Remaining Tag -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_item_product_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/fg"
            android:textSize="14sp"
            tools:text="Wireless Gaming Mouse" />

        <TextView
            android:id="@+id/text_item_remaining_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_chip"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/status_orange"
            android:textSize="11sp"
            tools:text="5 Pending" />
    </LinearLayout>

    <!-- Row 2: SKU and Cost info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_item_sku"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:textColor="@color/fg_dim"
            android:textSize="12sp"
            tools:text="SKU: WGM-001 • Rate: ₹ 850.00" />
    </LinearLayout>

    <!-- Row 3: Quantities Breakdown (Ordered vs Received vs Remaining) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_tag_sku"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/text_item_ordered_qty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/fg_muted"
            android:textSize="12sp"
            tools:text="Ordered: 10" />

        <TextView
            android:id="@+id/text_item_received_qty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/status_green"
            android:textSize="12sp"
            tools:text="Received: 5" />

        <TextView
            android:id="@+id/text_item_remaining_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/status_orange"
            android:textSize="12sp"
            tools:text="Remaining: 5" />
    </LinearLayout>

    <!-- Row 4: Receive Input Stepper & Quick Fill Button -->
    <LinearLayout
        android:id="@+id/layout_receive_input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Receive Now:"
            android:textColor="@color/fg"
            android:textSize="13sp" />

        <!-- Stepper: Minus, EditText, Plus -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_search_box"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_qty_minus"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_icon_button_ripple"
                android:clickable="true"
                android:contentDescription="Decrease quantity"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_minus"
                app:tint="@color/fg" />

            <EditText
                android:id="@+id/edit_receive_qty"
                android:layout_width="54dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="5"
                android:text="0"
                android:textColor="@color/accent_teal"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btn_qty_plus"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_icon_button_ripple"
                android:clickable="true"
                android:contentDescription="Increase quantity"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_add"
                app:tint="@color/fg" />
        </LinearLayout>

        <!-- Quick Fill 'All' Chip -->
        <TextView
            android:id="@+id/btn_receive_all"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_status_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="All"
            android:textColor="@color/accent_teal"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Batch & Expiry Input Container (Visible if product.batchEnabled && remaining > 0) -->
    <LinearLayout
        android:id="@+id/layout_batch_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_box"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_nav_inventory"
                app:tint="@color/accent_teal" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:text="BATCH &amp; EXPIRY REQUIRED"
                android:textColor="@color/accent_teal"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- Batch Number Input -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Batch No *"
                    android:textColor="@color/fg_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/edit_batch_number"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_card"
                    android:fontFamily="sans-serif"
                    android:hint="e.g. BATCH-01"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/fg"
                    android:textColorHint="@color/fg_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Expiry Date Picker Input -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Expiry Date *"
                    android:textColor="@color/fg_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/box_expiry_date"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:id="@+id/text_batch_expiry_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:hint="Select Date"
                        android:textColor="@color/fg"
                        android:textColorHint="@color/fg_dim"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/fg_dim" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Status / match hint -->
        <TextView
            android:id="@+id/text_batch_status_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/fg_dim"
            android:textSize="10sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Completed message if already fully received -->
    <TextView
        android:id="@+id/text_item_fully_received"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="✓ Item fully received"
        android:textColor="@color/status_green"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
