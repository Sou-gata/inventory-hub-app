<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_qr_label_root"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Store / System Brand Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="INVENTORY HUB"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_label_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/fg_dim"
            android:textSize="10sp"
            tools:text="16/09/2026" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@color/border" />

    <!-- Product Name -->
    <TextView
        android:id="@+id/tv_label_product_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:textAlignment="center"
        android:maxLines="2"
        android:textColor="@color/black"
        android:textSize="16sp"
        tools:text="Paracetamol 500mg Tablet" />

    <!-- SKU & Selling Price Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_label_product_sku"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_sku"
            android:fontFamily="monospace"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/fg_muted"
            android:textSize="12sp"
            tools:text="#MED-0042" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_label_product_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/fg"
            android:textSize="14sp"
            tools:text="₹ 45.00" />
    </LinearLayout>

    <!-- Center QR Code -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp"
        android:layout_gravity="center">

        <ImageView
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:contentDescription="QR Code"
            android:src="@drawable/qr_frame"
            android:layout_gravity="center"
            android:scaleType="fitCenter"/>

        <ImageView
            android:id="@+id/iv_label_qr_code"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_gravity="center"
            android:contentDescription="QR Code"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Batch Information (Visible ONLY if batch is present) -->
    <LinearLayout
        android:id="@+id/container_label_batch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tag_sku"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_label_batch_no"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/fg"
            android:textSize="12sp"
            tools:text="Batch: BN-26259-001" />

        <TextView
            android:id="@+id/tv_label_expiry_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/fg_muted"
            android:textSize="12sp"
            tools:text="Exp: 24/12/2026" />
    </LinearLayout>

</LinearLayout>
