<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="vertical">

    <!-- Item Name / Description -->
    <TextView
        android:id="@+id/tv_bill_item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:textColor="@color/black"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="Paracetamol 500mg Tablet" />

    <!-- 4-Column Row: SKU/HSN/Batch, Qty, Rate, Amount -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_bill_item_subtext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.2"
            android:fontFamily="monospace"
            android:textColor="@color/black"
            android:textSize="10sp"
            tools:text="HSN: 3004 | BN-001" />

        <TextView
            android:id="@+id/tv_bill_item_qty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="11sp"
            tools:text="2.00" />

        <TextView
            android:id="@+id/tv_bill_item_rate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:fontFamily="monospace"
            android:gravity="end"
            android:textColor="@color/black"
            android:textSize="11sp"
            tools:text="45.00" />

        <TextView
            android:id="@+id/tv_bill_item_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:fontFamily="monospace"
            android:gravity="end"
            android:textColor="@color/black"
            android:textSize="11sp"
            tools:text="90.00" />
    </LinearLayout>

    <!-- Optional Discount / Tax breakdown line -->
    <TextView
        android:id="@+id/tv_bill_item_tax_disc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/black"
        android:textSize="9sp"
        android:visibility="gone"
        tools:text="Disc: 5% | GST: 18%"
        tools:visibility="visible" />

</LinearLayout>
