<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    tools:context=".activities.UnitOfMeasureActivity">

    <!-- Main content container -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header container extending behind status bar -->
        <FrameLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_toolbar">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:navigationIconTint="@color/white"
                app:title="Unit of Measure"
                app:titleTextColor="@color/white" />
        </FrameLayout>

        <!-- Wrap content + FAB in a FrameLayout -->
        <FrameLayout
            android:id="@+id/uom_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- UOM List Container -->
            <LinearLayout
                android:id="@+id/layout_list_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Search Bar Container -->
                <LinearLayout
                    android:id="@+id/container_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:id="@+id/layout_search_box"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_search_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_search"
                            app:tint="@color/fg_dim" />

                        <EditText
                            android:id="@+id/edit_search_uom"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:fontFamily="sans-serif"
                            android:hint="Search units of measure..."
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/fg"
                            android:textColorHint="@color/fg_dim"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/btn_clear_search"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_icon_button_ripple"
                            android:clickable="true"
                            android:contentDescription="Clear search"
                            android:focusable="true"
                            android:padding="6dp"
                            android:src="@drawable/ic_close"
                            android:visibility="gone"
                            app:tint="@color/fg_dim" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Header Meta Info: Total Count -->
                <LinearLayout
                    android:id="@+id/container_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/text_meta_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:text="ALL UNITS OF MEASURE"
                        android:textColor="@color/fg_dim"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/text_uom_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/material_blue"
                        android:textSize="12sp"
                        tools:text="6 Units" />
                </LinearLayout>

                <!-- Search Empty State -->
                <LinearLayout
                    android:id="@+id/layout_search_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="32dp"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:alpha="0.4"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/fg_dim" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="No Units Found"
                        android:textColor="@color/fg"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/text_search_empty_query"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:textColor="@color/fg_dim"
                        android:textSize="13sp"
                        tools:text="No units found matching query" />

                    <TextView
                        android:id="@+id/btn_reset_search"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_cart_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="Clear Search"
                        android:textColor="@color/material_blue"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- RecyclerView List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_uom"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="88dp"
                    tools:listitem="@layout/item_unit_of_measure" />

            </LinearLayout>

            <!-- Complete Empty State -->
            <LinearLayout
                android:id="@+id/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:alpha="0.5"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_uom"
                    app:tint="@color/material_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="No Units of Measure Yet"
                    android:textColor="@color/fg"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="Add units like Box, Dozen, Meter, etc. to standardize your stock measurement."
                    android:textColor="@color/fg_muted"
                    android:textSize="14sp" />

                <FrameLayout
                    android:id="@+id/btn_empty_add_uom"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_button_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="24dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Add Unit of Measure"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Floating Action Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_add_uom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="20dp"
                android:contentDescription="Add Unit of Measure"
                android:src="@drawable/ic_add"
                app:backgroundTint="@color/accent_teal"
                app:elevation="6dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.InventoryHub.FAB.Rounded"
                app:tint="@color/white" />

        </FrameLayout>

    </LinearLayout>

    <!-- Navigation drawer -->
    <LinearLayout
        android:id="@+id/nav_drawer_container"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/nav_bg"
        android:orientation="vertical">

        <!-- Fixed Header -->
        <include
            android:id="@+id/nav_header_container"
            layout="@layout/nav_header" />

        <!-- Scrollable Navigation Items -->
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/nav_bg"
            app:itemBackground="@drawable/bg_nav_item_selector"
            app:itemHorizontalPadding="24dp"
            app:itemIconPadding="16dp"
            app:itemIconTint="@color/nav_item_icon_tint"
            app:itemTextColor="@color/nav_item_text_color"
            app:itemVerticalPadding="10dp"
            app:menu="@menu/drawer_menu"
            app:subheaderColor="@color/fg_dim"
            app:subheaderInsetStart="24dp" />

        <!-- Bottom Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- Logout Button Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_nav_logout_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/error_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/logout"
                    android:textColor="@color/error_red"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:alpha="0.6"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/error_red" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
