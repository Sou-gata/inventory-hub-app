<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_search_box"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Row 1: Product Name & Total Amount -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_item_product_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/fg"
            android:textSize="14sp"
            tools:text="Wireless Mechanical Keyboard RGB" />

        <TextView
            android:id="@+id/text_item_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/accent_teal"
            android:textSize="14sp"
            tools:text="₹ 4,999.00" />
    </LinearLayout>

    <!-- Row 2: SKU and Cost Price -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_item_sku"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_sku"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/fg_dim"
            android:textSize="10sp"
            tools:text="SKU: KB-9812" />

        <TextView
            android:id="@+id/text_item_qty_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:textColor="@color/fg_dim"
            android:textSize="12sp"
            tools:text="Cost Price: ₹ 2,200.00" />
    </LinearLayout>

    <!-- Row 3: Fulfillment Status Breakdown Chips (Ordered, Received, Pending/Cancelled) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Ordered Chip -->
        <TextView
            android:id="@+id/chip_ordered_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_sku"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/fg_muted"
            android:textSize="11sp"
            tools:text="Ordered: 12" />

        <!-- Received Chip -->
        <TextView
            android:id="@+id/chip_received_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_status_chip"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/status_blue"
            android:textSize="11sp"
            tools:text="Received: 8" />

        <!-- Remaining / Cancelled Chip -->
        <TextView
            android:id="@+id/chip_balance_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_status_chip"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/status_red"
            android:textSize="11sp"
            tools:text="Cancelled: 4" />
    </LinearLayout>

    <!-- Row 4: Tax & Discount Details -->
    <LinearLayout
        android:id="@+id/layout_item_tax_discount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_item_tax_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:textColor="@color/fg_dim"
            android:textSize="11sp"
            tools:text="GST: 18% (₹ 396.00)" />

        <TextView
            android:id="@+id/text_item_discount_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/accent_amber"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Disc: ₹ 100.00"
            tools:visibility="visible" />
    </LinearLayout>

</LinearLayout>
