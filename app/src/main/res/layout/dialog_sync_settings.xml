<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter your registered email and phone number to sync settings with the server."
        android:textColor="@color/fg_muted"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_sync_email"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Email Address *"
        app:boxStrokeColor="@color/accent_teal"
        app:errorEnabled="true"
        app:hintTextColor="@color/accent_teal"
        app:startIconDrawable="@drawable/ic_email"
        app:startIconTint="@color/accent_teal">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_sync_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_sync_phone"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="Phone Number (10 digits) *"
        app:boxStrokeColor="@color/accent_teal"
        app:errorEnabled="true"
        app:hintTextColor="@color/accent_teal"
        app:startIconDrawable="@drawable/ic_phone"
        app:startIconTint="@color/accent_teal">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_sync_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:maxLength="10"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
