<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    tools:context=".activities.UserWiseReportActivity">

    <!-- Main content container -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header container extending behind status bar -->
        <FrameLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_toolbar">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:navigationIconTint="@color/white"
                app:title="User Wise Report"
                app:titleTextColor="@color/white" />
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/user_wise_report_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 1. DATE RANGE FILTER CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.06"
                        android:text="RETURN PERIOD / DATE RANGE"
                        android:textColor="@color/fg_muted"
                        android:textSize="11sp" />

                    <!-- Date pickers row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <!-- Start Date -->
                        <LinearLayout
                            android:id="@+id/btn_pick_start_date"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/material_blue" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="From"
                                    android:textColor="@color/fg_dim"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tv_start_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="01 Oct 2026"
                                    android:textColor="@color/fg"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- End Date -->
                        <LinearLayout
                            android:id="@+id/btn_pick_end_date"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/material_blue" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="To"
                                    android:textColor="@color/fg_dim"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tv_end_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="31 Oct 2026"
                                    android:textColor="@color/fg"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Quick Preset Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip_today"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_tab_inactive"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="Today"
                                android:textColor="@color/fg_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_this_month"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_tab_active"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="This Month"
                                android:textColor="@color/white"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_last_month"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_tab_inactive"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="Last Month"
                                android:textColor="@color/fg_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_this_quarter"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_tab_inactive"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="This Quarter"
                                android:textColor="@color/fg_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_all_time"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_tab_inactive"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="All Time"
                                android:textColor="@color/fg_muted"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Action Buttons: Generate & Export -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_generate_report"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/material_blue"
                            android:fontFamily="sans-serif-bold"
                            android:text="Generate"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_export_report"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:text="Export Report"
                            android:textColor="@color/material_blue"
                            android:textSize="12sp"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_nav_reports"
                            app:iconGravity="textStart"
                            app:iconSize="16dp"
                            app:iconTint="@color/material_blue"
                            app:strokeColor="@color/material_blue" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. USER & ROLE FILTER CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.06"
                        android:text="USER &amp; SEARCH FILTER"
                        android:textColor="@color/fg_muted"
                        android:textSize="11sp" />

                    <!-- User Picker Row -->
                    <LinearLayout
                        android:id="@+id/btn_select_user"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_field_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nav_user"
                            app:tint="@color/material_blue" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Target User Filter"
                                android:textColor="@color/fg_dim"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tv_selected_user_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:text="All Users (Staff &amp; Admins)"
                                android:textColor="@color/fg"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/btn_clear_user_filter"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="Clear user filter"
                            android:padding="2dp"
                            android:src="@drawable/ic_close"
                            android:visibility="gone"
                            app:tint="@color/fg_dim" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_drop_down"
                            app:tint="@color/fg_dim" />
                    </LinearLayout>

                    <!-- Real-Time Search Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_field_normal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_search"
                            app:tint="@color/fg_dim" />

                        <EditText
                            android:id="@+id/input_search"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="Search user name, username, or role..."
                            android:imeOptions="actionDone"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/fg"
                            android:textColorHint="@color/fg_dim"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/btn_clear_search"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Clear search"
                            android:padding="2dp"
                            android:src="@drawable/ic_close"
                            android:visibility="gone"
                            app:tint="@color/fg_dim" />
                    </LinearLayout>

                    <!-- Role Filter Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip_filter_all_roles"
                                android:layout_width="wrap_content"
                                android:layout_height="26dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_tab_active"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="All Roles"
                                android:textColor="@color/white"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_filter_admin"
                                android:layout_width="wrap_content"
                                android:layout_height="26dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_tab_inactive"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="Admin"
                                android:textColor="@color/fg_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_filter_staff"
                                android:layout_width="wrap_content"
                                android:layout_height="26dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_tab_inactive"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="Staff"
                                android:textColor="@color/fg_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_filter_active_only"
                                android:layout_width="wrap_content"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_tab_inactive"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="With Transactions"
                                android:textColor="@color/fg_muted"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- 3. KPI SUMMARY CARDS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.06"
                        android:text="EXECUTIVE SUMMARY"
                        android:textColor="@color/fg_muted"
                        android:textSize="11sp" />

                    <!-- KPI Row 1: Gross Sales & Gross Purchases -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Gross Sales -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="GROSS SALES"
                                android:textColor="@color/fg_dim"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/kpi_gross_sales"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-black"
                                android:text="₹ 0.00"
                                android:textColor="@color/fg"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/kpi_sales_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="0 invoices"
                                android:textColor="@color/material_blue"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Gross Purchases -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="GROSS PURCHASES"
                                android:textColor="@color/fg_dim"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/kpi_gross_purchases"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-black"
                                android:text="₹ 0.00"
                                android:textColor="@color/fg"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/kpi_purchase_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="0 purchase orders"
                                android:textColor="@color/status_orange"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- KPI Row 2: Sales GST & Purchase GST -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- Sales GST -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="SALES GST (OUTPUT TAX)"
                                android:textColor="@color/fg_dim"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/kpi_sales_gst"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="₹ 0.00"
                                android:textColor="@color/fg"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <!-- Purchase GST -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="PURCHASE GST (INPUT TAX)"
                                android:textColor="@color/fg_dim"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/kpi_purchase_gst"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="₹ 0.00"
                                android:textColor="@color/fg"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- KPI Row 3: Total Combined GST & Net Turnover -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- Combined GST -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="COMBINED GST HANDLED"
                                android:textColor="@color/fg_dim"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/kpi_total_gst"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="₹ 0.00"
                                android:textColor="@color/material_blue"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <!-- Net Turnover (Sales - Purchases) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="NET TURNOVER (SALES - PUR)"
                                android:textColor="@color/fg_dim"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/kpi_net_turnover"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-black"
                                android:text="₹ 0.00"
                                android:textColor="@color/status_green"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 4. USER DETAILS TABLE CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.06"
                            android:text="USER BREAKDOWN TABLE"
                            android:textColor="@color/fg_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_table_records_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="0 users"
                            android:textColor="@color/fg_dim"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Horizontal scrollable table -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:overScrollMode="never"
                        android:scrollbars="horizontal">

                        <TableLayout
                            android:id="@+id/table_user_report"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:stretchColumns="*" />
                    </HorizontalScrollView>

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/layout_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="32dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nav_user"
                            app:tint="@color/fg_dim" />

                        <TextView
                            android:id="@+id/tv_empty_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="No transactions found for the selected user and date range."
                            android:textColor="@color/fg_dim"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="false"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/fg_muted"
        app:itemShapeInsetBottom="0dp"
        app:itemShapeInsetEnd="0dp"
        app:itemShapeInsetStart="0dp"
        app:itemShapeInsetTop="0dp"
        app:itemTextColor="@color/fg"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
