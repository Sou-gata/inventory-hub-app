<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_tag_sku" />

    <!-- Top Header: Title & Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_detail_supplier_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/fg"
                android:textSize="20sp"
                tools:text="Apex Logistics &amp; Supplies" />

            <TextView
                android:id="@+id/text_detail_contact_person"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/fg_dim"
                android:textSize="13sp"
                tools:text="Contact: Vikram Patel" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn_close_supplier_detail"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_button_ripple"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Close"
                android:src="@drawable/ic_close"
                app:tint="@color/fg_dim" />
        </FrameLayout>
    </LinearLayout>

    <!-- Status & ID Pills Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Status Badge -->
        <LinearLayout
            android:id="@+id/layout_detail_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <View
                android:id="@+id/view_detail_status_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_status_dot" />

            <TextView
                android:id="@+id/text_detail_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/accent_teal"
                android:textSize="12sp"
                tools:text="Active" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_detail_supplier_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tag_sku"
            android:fontFamily="monospace"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/fg_muted"
            android:textSize="11sp"
            tools:text="#SUPPLIER-501" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/text_detail_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/fg_dim"
            android:textSize="11sp"
            tools:text="Added Sep 11, 2026" />
    </LinearLayout>

    <!-- Quick Contact Buttons (Call & Email) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_action_call"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_field_normal"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/accent_teal" />

                <TextView
                    android:id="@+id/text_quick_call"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/fg"
                    android:textSize="13sp"
                    tools:text="Call" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_action_email"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_field_normal"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_email"
                    app:tint="@color/accent_blue" />

                <TextView
                    android:id="@+id/text_quick_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/fg"
                    android:textSize="13sp"
                    tools:text="Email" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Details Card (Phone, Email, GST, PAN, Address, Notes) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_field_normal"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Phone Row -->
        <LinearLayout
            android:id="@+id/row_detail_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="3dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Phone"
                android:textColor="@color/fg_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_detail_phone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/fg"
                android:textSize="13sp"
                tools:text="+91 91234 56789" />
        </LinearLayout>

        <!-- Email Row -->
        <LinearLayout
            android:id="@+id/row_detail_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:paddingVertical="3dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Email"
                android:textColor="@color/fg_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_detail_email"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/fg"
                android:textSize="13sp"
                tools:text="vikram@apexsupplies.com" />
        </LinearLayout>

        <!-- GST & PAN Row -->
        <LinearLayout
            android:id="@+id/row_detail_gst_pan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:paddingVertical="3dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="GST / PAN"
                android:textColor="@color/fg_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_detail_gst_pan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/fg"
                android:textSize="13sp"
                tools:text="24BBBBB0000B1Z6 • FGHIJ5678K" />
        </LinearLayout>

        <!-- Address Row -->
        <LinearLayout
            android:id="@+id/row_detail_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:paddingVertical="3dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Address"
                android:textColor="@color/fg_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_detail_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/fg"
                android:textSize="13sp"
                tools:text="Warehouse 7, GIDC Estate, Ahmedabad, Gujarat 382445, India" />
        </LinearLayout>

        <!-- Notes Row -->
        <LinearLayout
            android:id="@+id/row_detail_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:paddingVertical="3dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Notes"
                android:textColor="@color/fg_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_detail_notes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:textColor="@color/fg_muted"
                android:textSize="13sp"
                tools:text="Primary raw materials distributor with 15-day credit terms." />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Actions: Edit & Deactivate / Activate Buttons (NO delete button) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <!-- Deactivate / Activate Button -->
        <FrameLayout
            android:id="@+id/btn_detail_toggle_status"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_field_normal"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/icon_detail_toggle"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_power"
                    app:tint="@color/fg_muted" />

                <TextView
                    android:id="@+id/text_detail_toggle_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/fg"
                    android:textSize="14sp"
                    tools:text="Deactivate" />
            </LinearLayout>
        </FrameLayout>

        <!-- Edit Profile Button -->
        <FrameLayout
            android:id="@+id/btn_detail_edit_supplier"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Edit Details"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
