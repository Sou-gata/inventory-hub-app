<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tag_sku" />

        <!-- Top Header: Title & Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_detail_invoice_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/fg"
                    android:textSize="20sp"
                    tools:text="PO-20260918-1045" />

                <TextView
                    android:id="@+id/text_detail_date_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/fg_dim"
                    android:textSize="13sp"
                    tools:text="Ordered on 18 Sep 2026" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btn_close_receive"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_button_ripple"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Close"
                    android:src="@drawable/ic_close"
                    app:tint="@color/fg_dim" />
            </FrameLayout>
        </LinearLayout>

        <!-- Status & Meta Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layout_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <View
                    android:id="@+id/view_status_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_status_dot" />

                <TextView
                    android:id="@+id/text_detail_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/status_orange"
                    android:textSize="12sp"
                    tools:text="Pending" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_detail_sale_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/fg_dim"
                android:textSize="12sp"
                tools:text="#PO-4" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/border" />

        <!-- Supplier Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card2"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_supplier"
                    app:tint="@color/accent_teal" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06"
                    android:text="SUPPLIER INFORMATION"
                    android:textColor="@color/accent_teal"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/btn_action_call_supplier"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_icon_button_ripple"
                    android:clickable="true"
                    android:contentDescription="Call supplier"
                    android:focusable="true"
                    android:padding="5dp"
                    android:src="@drawable/ic_phone"
                    android:visibility="gone"
                    app:tint="@color/accent_teal"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_detail_supplier_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/fg"
                android:textSize="15sp"
                tools:text="ABC Wholesale Pvt Ltd" />

            <TextView
                android:id="@+id/text_detail_supplier_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/fg_dim"
                android:textSize="13sp"
                tools:text="Phone: +91 98765 43210" />

            <TextView
                android:id="@+id/text_detail_supplier_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/fg_dim"
                android:textSize="13sp"
                tools:text="Address: 123 Industrial Area, Phase 2, Kolkata" />
        </LinearLayout>

        <!-- Items Header with 'Receive All' button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="RECEIVE ORDER ITEMS"
                android:textColor="@color/accent_teal"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/text_detail_items_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/fg_dim"
                android:textSize="12sp"
                tools:text="3 items" />

            <TextView
                android:id="@+id/btn_receive_all_items"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_status_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Receive All"
                android:textColor="@color/accent_teal"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Progress Spinner while loading items -->
        <ProgressBar
            android:id="@+id/progress_detail_items"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="16dp"
            android:indeterminateTint="@color/accent_teal"
            android:visibility="gone" />

        <!-- Container for dynamically inflated item rows -->
        <LinearLayout
            android:id="@+id/container_receive_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- SECTION: PREVIOUS RECEIVING STAGES -->
        <LinearLayout
            android:id="@+id/section_previous_stages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/text_previous_stages_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="PREVIOUS RECEIVE STAGES"
                android:textColor="@color/accent_teal"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/container_previous_stages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Notes / Remarks Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-bold"
            android:text="Receive Notes (Optional)"
            android:textColor="@color/fg_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edit_receive_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_box"
            android:fontFamily="sans-serif"
            android:hint="e.g. Batch 1 received via Express Logistics, Box 2 pending"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:minLines="2"
            android:padding="10dp"
            android:textColor="@color/fg"
            android:textColorHint="@color/fg_dim"
            android:textSize="13sp" />

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Cancel Order Button -->
            <Button
                android:id="@+id/btn_cancel_order"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_logout_button"
                android:fontFamily="sans-serif-bold"
                android:text="@string/btn_cancel_order"
                android:textAllCaps="false"
                android:textColor="@color/error_red"
                android:textSize="14sp" />

            <!-- Confirm Receive Button -->
            <Button
                android:id="@+id/btn_confirm_receive"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.4"
                android:background="@drawable/bg_button"
                android:fontFamily="sans-serif-black"
                android:text="@string/btn_receive_items"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
