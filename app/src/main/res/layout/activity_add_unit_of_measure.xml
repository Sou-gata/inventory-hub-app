<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/add_uom_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    android:orientation="vertical">

    <!-- Header container extending behind status bar -->
    <FrameLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:navigationIconTint="@color/white"
            app:title="Add Unit of Measure"
            app:titleTextColor="@color/white" />
    </FrameLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="36dp">

            <!-- Error Banner -->
            <LinearLayout
                android:id="@+id/banner_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_error_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_error" />

                <TextView
                    android:id="@+id/text_error"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textColor="@color/error_red"
                    android:textSize="13sp"
                    tools:text="Please enter a unit name." />
            </LinearLayout>

            <!-- Protected Warning Banner (Only for default units) -->
            <LinearLayout
                android:id="@+id/banner_default_locked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_badge_default"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/status_orange" />

                <TextView
                    android:id="@+id/text_default_locked_msg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="This is a system default unit of measure. Default units (KG, Gram, Liter, Mililiter, Pics, Packet) are protected and cannot be edited or deleted."
                    android:textColor="@color/status_orange"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- SECTION HEADER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="UNIT DETAILS"
                android:textColor="@color/fg_muted"
                android:textSize="12sp" />

            <!-- FORM CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Field: Unit Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Unit Name"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="*"
                        android:textColor="@color/error_red"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/input_uom_name"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_field_normal"
                    android:fontFamily="sans-serif"
                    android:hint="e.g. Box, Dozen, Meter"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/fg"
                    android:textColorHint="@color/fg_dim"
                    android:textSize="14sp" />

                <!-- Quick Suggestion Chips Container -->
                <LinearLayout
                    android:id="@+id/layout_quick_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Quick Suggestions"
                        android:textColor="@color/fg_dim"
                        android:textSize="11sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/container_chips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip_box"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_cart_button"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="Box"
                                android:textColor="@color/fg"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/chip_dozen"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_cart_button"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="Dozen"
                                android:textColor="@color/fg"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/chip_bundle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_cart_button"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="Bundle"
                                android:textColor="@color/fg"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/chip_meter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_cart_button"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="Meter"
                                android:textColor="@color/fg"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/chip_roll"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_cart_button"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="Roll"
                                android:textColor="@color/fg"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/chip_carton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_cart_button"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="Carton"
                                android:textColor="@color/fg"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/chip_pair"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_cart_button"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="Pair"
                                android:textColor="@color/fg"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/chip_set"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_cart_button"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="Set"
                                android:textColor="@color/fg"
                                android:textSize="12sp" />

                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Field: Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Description (Optional)"
                    android:textColor="@color/fg"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/input_uom_desc"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_field_normal"
                    android:fontFamily="sans-serif"
                    android:gravity="top|start"
                    android:hint="Provide a brief description about this unit of measure..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="14dp"
                    android:textColor="@color/fg"
                    android:textColorHint="@color/fg_dim"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Save / Update Button -->
            <FrameLayout
                android:id="@+id/btn_save_uom"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_ripple"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/container_save_idle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/text_save_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Save Unit of Measure"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_saving"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Delete Button (Only shown in Edit mode for non-default units) -->
            <FrameLayout
                android:id="@+id/btn_delete_uom_action"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_danger"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_delete_outline"
                        app:tint="@color/error_red" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Delete Unit of Measure"
                        android:textColor="@color/error_red"
                        android:textSize="14sp" />
                </LinearLayout>

            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
