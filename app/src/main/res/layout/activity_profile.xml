<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    tools:context=".activities.ProfileActivity">

    <!-- Main Content Container -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar Header Container -->
        <FrameLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_toolbar">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:navigationIconTint="@color/white"
                app:title="@string/profile"
                app:titleTextColor="@color/white" />
        </FrameLayout>

        <!-- Scrollable Profile Content -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="40dp">

                <!-- Error Banner -->
                <LinearLayout
                    android:id="@+id/banner_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_error_banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_error"
                        app:tint="@color/error_red" />

                    <TextView
                        android:id="@+id/text_error"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/error_red"
                        android:textSize="13sp"
                        tools:text="Please enter a valid company name." />
                </LinearLayout>

                <!-- Success Banner -->
                <LinearLayout
                    android:id="@+id/banner_success"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_success_banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check"
                        app:tint="@color/status_green" />

                    <TextView
                        android:id="@+id/text_success"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="Company configuration saved successfully!"
                        android:textColor="@color/status_green"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- USER ACCOUNT PROFILE CARD -->
                <LinearLayout
                    android:id="@+id/card_user_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Avatar + Primary Details Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Avatar Circle -->
                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_nav_logo">

                            <TextView
                                android:id="@+id/text_profile_avatar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                tools:text="ST" />

                            <ImageView
                                android:id="@+id/icon_profile_avatar"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_nav_user"
                                android:visibility="gone"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <!-- User Meta Details -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/text_profile_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-black"
                                    android:textColor="@color/fg"
                                    android:textSize="17sp"
                                    tools:text="Sougata Talukdar" />

                                <TextView
                                    android:id="@+id/text_profile_role"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_nav_role_user"
                                    android:fontFamily="sans-serif-medium"
                                    android:includeFontPadding="false"
                                    android:paddingHorizontal="7dp"
                                    android:paddingVertical="2dp"
                                    android:textAllCaps="true"
                                    android:textColor="@color/material_blue"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    tools:text="ADMIN" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/text_profile_username"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:textColor="@color/fg_dim"
                                android:textSize="13sp"
                                tools:text="\@sougata" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/border" />

                    <!-- Contact Meta Info: Email & Phone -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_email"
                            app:tint="@color/accent_teal" />

                        <TextView
                            android:id="@+id/text_profile_email"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/fg_muted"
                            android:textSize="13sp"
                            tools:text="sougatatalukdar77@gmail.com" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/accent_teal" />

                        <TextView
                            android:id="@+id/text_profile_phone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/fg_muted"
                            android:textSize="13sp"
                            tools:text="7797454561" />
                    </LinearLayout>
                </LinearLayout>

                <!-- COMPANY CONFIGURATION SECTION HEADER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:text="COMPANY CONFIGURATION"
                        android:textColor="@color/fg_muted"
                        android:textSize="12sp" />

                    <!-- Mode Indicator Badge -->
                    <TextView
                        android:id="@+id/badge_edit_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_chip"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="View Mode"
                        android:textColor="@color/fg_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- SECTION 1: BUSINESS IDENTITY -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Company Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Company / Business Name *"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/input_company_name"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_field_normal"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. M/S. Lokenath Traders"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/fg"
                        android:textColorHint="@color/fg_dim"
                        android:textSize="14sp" />

                    <!-- Company Phone -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Company Phone Number"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/input_company_phone"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_field_normal"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. 7797454562"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/fg"
                        android:textColorHint="@color/fg_dim"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- SECTION 2: TAX IDENTIFIERS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:text="TAX &amp; STATUTORY IDENTIFIERS"
                    android:textColor="@color/fg_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- GSTIN -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="GSTIN (GST Number)"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/input_gst_number"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_field_normal"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. 19AFIPD6386B1ZG"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/fg"
                        android:textColorHint="@color/fg_dim"
                        android:textSize="14sp" />

                    <!-- PAN Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="PAN Number"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/input_pan_number"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_field_normal"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. AFIPD6386B"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/fg"
                        android:textColorHint="@color/fg_dim"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- SECTION 3: ADDRESS & LOCATION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:text="REGISTERED OFFICE ADDRESS"
                    android:textColor="@color/fg_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Street Address -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Street / Office Address"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/input_address"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_field_normal"
                        android:fontFamily="sans-serif"
                        android:gravity="top|start"
                        android:hint="e.g. 246/2, R. N. Tagore Road (3rd Floor)"
                        android:inputType="textMultiLine|textCapSentences"
                        android:padding="12dp"
                        android:textColor="@color/fg"
                        android:textColorHint="@color/fg_dim"
                        android:textSize="14sp" />

                    <!-- District & Postal Code (2 Columns) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <!-- District / City -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="District / City"
                                android:textColor="@color/fg"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/input_district"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:background="@drawable/bg_field_normal"
                                android:fontFamily="sans-serif"
                                android:hint="e.g. Kolkata"
                                android:inputType="textCapWords"
                                android:maxLines="1"
                                android:paddingHorizontal="14dp"
                                android:textColor="@color/fg"
                                android:textColorHint="@color/fg_dim"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Postal Code -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Postal / PIN Code"
                                android:textColor="@color/fg"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/input_postal_code"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:background="@drawable/bg_field_normal"
                                android:fontFamily="sans-serif"
                                android:hint="e.g. 700077"
                                android:inputType="number"
                                android:maxLines="1"
                                android:paddingHorizontal="14dp"
                                android:textColor="@color/fg"
                                android:textColorHint="@color/fg_dim"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- State -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="State / Region"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/input_state"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_field_normal"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. West Bengal"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/fg"
                        android:textColorHint="@color/fg_dim"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- SECTION 4: BILL PRINT FOOTER SETTINGS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:text="PRINTABLE BILL FOOTER SETTINGS"
                    android:textColor="@color/fg_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Footer 1 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Footer 1 (Bold)"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/input_footer_1"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_field_normal"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. THANK YOU! VISIT AGAIN"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/fg"
                        android:textColorHint="@color/fg_dim"
                        android:textSize="14sp" />

                    <!-- Footer 2 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Footer 2 (Bold)"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/input_footer_2"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_field_normal"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. Goods once sold will not be returned"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/fg"
                        android:textColorHint="@color/fg_dim"
                        android:textSize="14sp" />

                    <!-- Footer 3 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Footer 3 (Normal)"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/input_footer_3"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_field_normal"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. Subject to local jurisdiction"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/fg"
                        android:textColorHint="@color/fg_dim"
                        android:textSize="14sp" />

                    <!-- Footer 4 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Footer 4 (Normal)"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/input_footer_4"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_field_normal"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. Computer generated bill, signature not required"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/fg"
                        android:textColorHint="@color/fg_dim"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- ACTIONS CONTAINER -->
                <LinearLayout
                    android:id="@+id/layout_edit_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- Save Changes Button -->
                    <FrameLayout
                        android:id="@+id/btn_save_profile"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_button_ripple"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:id="@+id/container_save_idle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/text_save_button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Save Changes"
                                android:textColor="@color/white"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progress_saving"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/white"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Cancel Button -->
                    <TextView
                        android:id="@+id/btn_cancel_edit"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="Cancel &amp; Revert Changes"
                        android:textColor="@color/fg_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Edit Profile Button (When in View Mode) -->
                <FrameLayout
                    android:id="@+id/btn_enter_edit_mode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_button_ripple"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Edit Business Details"
                            android:textColor="@color/white"
                            android:textSize="15sp" />
                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- Side Navigation Drawer -->
    <LinearLayout
        android:id="@+id/nav_drawer_container"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/nav_bg"
        android:orientation="vertical">

        <!-- Fixed Header -->
        <include
            android:id="@+id/nav_header_container"
            layout="@layout/nav_header" />

        <!-- Scrollable Navigation Items -->
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/nav_bg"
            app:itemBackground="@drawable/bg_nav_item_selector"
            app:itemHorizontalPadding="24dp"
            app:itemIconPadding="16dp"
            app:itemIconTint="@color/nav_item_icon_tint"
            app:itemTextColor="@color/nav_item_text_color"
            app:itemVerticalPadding="10dp"
            app:menu="@menu/drawer_menu"
            app:subheaderColor="@color/fg_dim"
            app:subheaderInsetStart="24dp" />

        <!-- Bottom Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- Bottom Logout Section -->
        <LinearLayout
            android:id="@+id/nav_footer_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nav_bg"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/btn_nav_logout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_nav_logout_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/logout"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/error_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/logout"
                    android:textColor="@color/error_red"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:alpha="0.6"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/error_red" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>