<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_purchase_details"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_cart_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:listitem="@layout/item_cart_product"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/layout_empty_sell_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minHeight="400dp"
            android:orientation="vertical"
            android:paddingHorizontal="32dp">

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_empty_circle">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_sub_create_sale"
                    app:tint="@color/fg_dim" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/cart_empty_title"
                android:textColor="@color/fg"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/cart_empty_desc"
                android:textColor="@color/fg_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Invoice Details & Summary Container -->
        <LinearLayout
            android:id="@+id/layout_sell_summary_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- SECTION 1: SUPPLIER & INVOICE DETAILS CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:text="@string/purchase_section_supplier_info"
                    android:textColor="@color/fg_muted"
                    android:textSize="12sp" />

                <!-- Supplier Dropdown -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/purchase_label_supplier"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="*"
                        android:textColor="@color/error_red"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/container_customer_dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_field_normal"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <in.gbtsolutions.inventoryhub.views.InstantAutoCompleteTextView
                        android:id="@+id/dropdown_customer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:clickable="true"
                        android:cursorVisible="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:hint="@string/purchase_hint_supplier"
                        android:imeOptions="actionDone"
                        android:inputType="textCapWords|textNoSuggestions"
                        android:maxLines="1"
                        android:textColor="@color/fg"
                        android:textColorHint="@color/fg_dim"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/btn_clear_supplier"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_icon_button_ripple"
                        android:clickable="true"
                        android:contentDescription="Clear supplier"
                        android:focusable="true"
                        android:padding="6dp"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="@color/fg_dim" />

                    <ImageView
                        android:id="@+id/icon_supplier_dropdown"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_icon_button_ripple"
                        android:clickable="true"
                        android:contentDescription="Toggle dropdown"
                        android:focusable="true"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="@color/fg_muted" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/sell_label_invoice"
                            android:textColor="@color/fg"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_field_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp">

                            <EditText
                                android:id="@+id/input_invoice_number"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@null"
                                android:fontFamily="sans-serif"
                                android:hint="@string/purchase_hint_invoice"
                                android:imeOptions="actionNext"
                                android:inputType="textCapCharacters"
                                android:maxLines="1"
                                android:paddingHorizontal="14dp"
                                android:textColor="@color/fg"
                                android:textColorHint="@color/fg_dim"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/iv_clear_invoice"
                                android:layout_width="20dp"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_close"
                                app:tint="@color/error_red" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/purchase_label_date"
                            android:textColor="@color/fg"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/container_date_picker"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_field_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="14dp">

                            <EditText
                                android:id="@+id/input_sale_date"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@null"
                                android:clickable="true"
                                android:cursorVisible="false"
                                android:focusable="false"
                                android:hint="@string/sell_hint_date"
                                android:inputType="none"
                                android:textColor="@color/fg"
                                android:textColorHint="@color/fg_dim"
                                android:textSize="14sp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/fg_muted" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <!-- Toggle: Save as Pending Receive -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_search_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/receive_save_as_pending"
                            android:textColor="@color/fg"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="sans-serif"
                            android:text="Receive goods later via Pending Receipts"
                            android:textColor="@color/fg_dim"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_save_as_pending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

            </LinearLayout>

            <!-- SECTION 2: PRICE SUMMARY CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:text="@string/sell_section_price_summary"
                    android:textColor="@color/fg_muted"
                    android:textSize="12sp" />

                <!-- 1. Total Cart Value (Subtotal) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="@string/sell_label_subtotal"
                        android:textColor="@color/fg_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/text_cart_subtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/fg"
                        android:textSize="15sp"
                        tools:text="₹ 12,450.00" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/border" />

                <!-- 2. Total Discount Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="@string/sell_label_discount"
                        android:textColor="@color/fg_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/text_total_discount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/status_green"
                        android:textSize="14sp"
                        tools:text="-₹ 0.00" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/border" />

                <!-- 3. Total GST Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="@string/sell_label_gst"
                        android:textColor="@color/fg_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/text_total_gst"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/fg"
                        android:textSize="14sp"
                        tools:text="₹ 2,241.00" />
                </LinearLayout>

                <!-- CGST breakdown row -->
                <LinearLayout
                    android:id="@+id/row_cgst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="0dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="↳ CGST (50%)"
                        android:textColor="@color/fg_dim"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/text_cgst_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/fg_dim"
                        android:textSize="12sp"
                        tools:text="₹ 1,120.50" />
                </LinearLayout>

                <!-- SGST breakdown row -->
                <LinearLayout
                    android:id="@+id/row_sgst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="0dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="↳ SGST (50%)"
                        android:textColor="@color/fg_dim"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/text_sgst_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/fg_dim"
                        android:textSize="12sp"
                        tools:text="₹ 1,120.50" />
                </LinearLayout>

                <!-- IGST breakdown row -->
                <LinearLayout
                    android:id="@+id/row_igst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="0dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="↳ IGST (100%)"
                        android:textColor="@color/fg_dim"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/text_igst_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/fg_dim"
                        android:textSize="12sp"
                        tools:text="₹ 2,241.00" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/border" />

                <!-- 4. Other Charges Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="@string/sell_label_other_charges"
                        android:textColor="@color/fg_muted"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="120dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_compact"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="₹"
                            android:textColor="@color/fg_dim"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/input_other_charges"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:background="@android:color/transparent"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center_vertical|end"
                            android:hint="0.00"
                            android:imeOptions="actionDone"
                            android:inputType="numberDecimal"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/fg"
                            android:textColorHint="@color/fg_dim"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Strong Divider before Grand Total -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/border" />

                <!-- 5. Grand Total Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/sell_label_grand_total"
                        android:textColor="@color/fg"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/text_grand_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/accent_teal"
                        android:textSize="20sp"
                        tools:text="₹ 14,691.00" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btn_sell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="7dp"
            android:text="@string/btn_confirm_purchase" />

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Button for QR Scan / Add by QR -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_by_qr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/add_by_qr"
        android:src="@drawable/ic_qr_code"
        app:backgroundTint="@color/accent_teal"
        app:elevation="6dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.InventoryHub.FAB.Rounded"
        app:tint="@color/white" />

</FrameLayout>
