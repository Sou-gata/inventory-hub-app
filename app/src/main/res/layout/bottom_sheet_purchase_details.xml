<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tag_sku" />

        <!-- Top Header: Title & Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_detail_invoice_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/fg"
                    android:textSize="20sp"
                    tools:text="PO-20260918-1045" />

                <TextView
                    android:id="@+id/text_detail_date_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/fg_dim"
                    android:textSize="13sp"
                    tools:text="Purchased on 18 Sep 2026" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btn_close_sell_detail"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_button_ripple"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Close"
                    android:src="@drawable/ic_close"
                    app:tint="@color/fg_dim" />
            </FrameLayout>
        </LinearLayout>

        <!-- Status & Meta Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layout_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <View
                    android:id="@+id/view_status_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_status_dot" />

                <TextView
                    android:id="@+id/text_detail_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Completed"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_detail_sale_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/fg_dim"
                android:textSize="12sp"
                tools:text="#PO-12" />
        </LinearLayout>

        <!-- Responsible Person Card (Purchased & Received By) -->
        <!-- Responsible Person Card (Ordered By Only) -->
        <LinearLayout
            android:id="@+id/layout_detail_creator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_search_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_nav_user"
                app:tint="@color/accent_teal" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/label_detail_creator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Ordered by"
                    android:textColor="@color/fg_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_detail_creator_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:textColor="@color/fg"
                    android:textSize="13sp"
                    tools:text="Sougata Talukdar (@sougata)" />

                <TextView
                    android:id="@+id/text_detail_creator_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/fg_dim"
                    android:textSize="11sp"
                    tools:text="10 Units ordered" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_detail_creator_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_pill"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/accent_teal"
                android:textSize="11sp"
                tools:text="ADMIN" />
        </LinearLayout>

        <!-- Cancellation Banner (Visible when Partially Cancelled or Cancelled) -->
        <LinearLayout
            android:id="@+id/layout_cancellation_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_error_banner"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_remove_circle"
                    app:tint="@color/status_red" />

                <TextView
                    android:id="@+id/text_cancellation_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="ORDER PARTIALLY CANCELLED"
                    android:textColor="@color/status_red"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_cancellation_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/status_red"
                android:textSize="12sp"
                tools:text="Cancelled on 23 Sep 2026. 8 of 12 units received; remaining 4 units were cancelled." />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/border" />

        <!-- SECTION: SUPPLIER INFO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:text="SUPPLIER"
            android:textColor="@color/fg_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/text_detail_buyer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/fg"
            android:textSize="16sp"
            tools:text="ABC Wholesale Pvt Ltd" />

        <TextView
            android:id="@+id/text_detail_buyer_contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/fg_muted"
            android:textSize="13sp"
            tools:text="Contact: Rajesh Sharma"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_detail_buyer_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/fg_muted"
            android:textSize="13sp"
            tools:text="Phone: +91 98765 43210"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_detail_buyer_gst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/fg_muted"
            android:textSize="13sp"
            tools:text="GSTIN: 33AADCB1234N1ZR"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_detail_buyer_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/fg_muted"
            android:textSize="13sp"
            tools:text="Address: 42 Main Street, Chennai, TN - 600001"
            android:visibility="gone" />

        <!-- Call Supplier Button -->
        <LinearLayout
            android:id="@+id/btn_action_call_buyer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_status_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Call"
                android:src="@drawable/ic_phone"
                app:tint="@color/accent_teal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="Call Supplier"
                android:textColor="@color/accent_teal"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/border" />

        <!-- SECTION: ITEMS PURCHASED -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="ITEMS PURCHASED"
                android:textColor="@color/fg_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/text_detail_items_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textColor="@color/fg_dim"
                android:textSize="12sp"
                tools:text="3 items" />
        </LinearLayout>

        <!-- Items container - inflated dynamically -->
        <LinearLayout
            android:id="@+id/container_detail_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <ProgressBar
            android:id="@+id/progress_detail_items"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/border" />

        <!-- SECTION: RECEIVING STAGES (GRN) -->
        <LinearLayout
            android:id="@+id/section_receive_stages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="RECEIVING STAGES (GRN)"
                    android:textColor="@color/accent_teal"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_stages_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/fg_dim"
                    android:textSize="12sp"
                    tools:text="2 stages" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_receive_stages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <ProgressBar
                android:id="@+id/progress_detail_stages"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/border" />
        </LinearLayout>

        <!-- SECTION: FINANCIAL SUMMARY -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:text="PURCHASE SUMMARY"
            android:textColor="@color/fg_muted"
            android:textSize="11sp" />

        <!-- Subtotal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="Subtotal (Cost)"
                android:textColor="@color/fg_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_summary_subtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/fg"
                android:textSize="13sp"
                tools:text="₹ 22,000.00" />
        </LinearLayout>

        <!-- Discount Row -->
        <LinearLayout
            android:id="@+id/row_summary_discount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="Discount"
                android:textColor="@color/fg_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_summary_discount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/status_green"
                android:textSize="13sp"
                tools:text="- ₹ 500.00" />
        </LinearLayout>

        <!-- CGST Row -->
        <LinearLayout
            android:id="@+id/row_summary_cgst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="CGST"
                android:textColor="@color/fg_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_summary_cgst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/fg"
                android:textSize="13sp"
                tools:text="₹ 990.00" />
        </LinearLayout>

        <!-- SGST Row -->
        <LinearLayout
            android:id="@+id/row_summary_sgst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="SGST"
                android:textColor="@color/fg_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_summary_sgst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/fg"
                android:textSize="13sp"
                tools:text="₹ 990.00" />
        </LinearLayout>

        <!-- IGST Row -->
        <LinearLayout
            android:id="@+id/row_summary_igst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="IGST"
                android:textColor="@color/fg_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_summary_igst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/fg"
                android:textSize="13sp"
                tools:text="₹ 1,980.00" />
        </LinearLayout>

        <!-- Total GST Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="Total GST"
                android:textColor="@color/fg_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_summary_total_gst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/fg"
                android:textSize="13sp"
                tools:text="₹ 1,980.00" />
        </LinearLayout>

        <!-- Other Charges Row -->
        <LinearLayout
            android:id="@+id/row_summary_other_charges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="Other Charges"
                android:textColor="@color/fg_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_summary_other_charges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/fg"
                android:textSize="13sp"
                tools:text="₹ 200.00" />
        </LinearLayout>

        <!-- Grand Total Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="@color/border" />

        <!-- Grand Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="Grand Total"
                android:textColor="@color/fg"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/text_summary_grand_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/accent_teal"
                android:textSize="18sp"
                tools:text="₹ 23,680.00" />
        </LinearLayout>

        <!-- Done Button -->
        <Button
            android:id="@+id/btn_detail_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Done" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
