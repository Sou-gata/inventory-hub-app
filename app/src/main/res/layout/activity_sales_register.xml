<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    tools:context=".activities.SalesRegisterActivity">

    <!-- Main content container -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header container extending behind status bar -->
        <FrameLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_toolbar">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:navigationIconTint="@color/white"
                app:title="Sales Register"
                app:titleTextColor="@color/white" />
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/sales_register_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 1. DATE RANGE FILTER CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.06"
                        android:text="RETURN PERIOD / DATE RANGE"
                        android:textColor="@color/fg_muted"
                        android:textSize="11sp" />

                    <!-- Date pickers row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <!-- Start Date -->
                        <LinearLayout
                            android:id="@+id/btn_pick_start_date"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_nav_sub_sales_register"
                                app:tint="@color/material_blue" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="From"
                                    android:textColor="@color/fg_dim"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tv_start_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="01 Sep 2026"
                                    android:textColor="@color/fg"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- End Date -->
                        <LinearLayout
                            android:id="@+id/btn_pick_end_date"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_nav_sub_sales_register"
                                app:tint="@color/material_blue" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="To"
                                    android:textColor="@color/fg_dim"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tv_end_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="30 Sep 2026"
                                    android:textColor="@color/fg"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Quick Preset Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip_today"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_tab_inactive"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="Today"
                                android:textColor="@color/fg_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_this_month"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_tab_active"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="This Month"
                                android:textColor="@color/white"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_last_month"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_tab_inactive"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="Last Month"
                                android:textColor="@color/fg_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_this_quarter"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_tab_inactive"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="This Quarter"
                                android:textColor="@color/fg_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_all_time"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_tab_inactive"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="All Time"
                                android:textColor="@color/fg_muted"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Action Buttons: Generate & Export -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_generate_report"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/material_blue"
                            android:fontFamily="sans-serif-bold"
                            android:text="Generate"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_export_report"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:text="Export Report"
                            android:textColor="@color/material_blue"
                            android:textSize="12sp"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_nav_reports"
                            app:iconGravity="textStart"
                            app:iconSize="16dp"
                            app:iconTint="@color/material_blue"
                            app:strokeColor="@color/material_blue" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. SEARCH & TYPE FILTER CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Search Input -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_field_normal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_search"
                            app:tint="@color/fg_dim" />

                        <EditText
                            android:id="@+id/input_search"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="Search customer, invoice #, phone, GSTIN..."
                            android:imeOptions="actionDone"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/fg"
                            android:textColorHint="@color/fg_dim"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/btn_clear_search"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Clear search"
                            android:padding="2dp"
                            android:src="@drawable/ic_close"
                            android:visibility="gone"
                            app:tint="@color/fg_dim" />
                    </LinearLayout>

                    <!-- Filter Chips: All, B2B, B2C -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_filter_all"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_tab_active"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="All Sales"
                            android:textColor="@color/white"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/chip_filter_b2b"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_tab_inactive"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="B2B (Registered)"
                            android:textColor="@color/fg_muted"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/chip_filter_b2c"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_tab_inactive"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="B2C (Retail)"
                            android:textColor="@color/fg_muted"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. KPI SUMMARY CARDS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- Gross Sales -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.05"
                            android:text="GROSS SALES"
                            android:textColor="@color/fg_muted"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/kpi_gross_sales"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/material_blue"
                            android:textSize="15sp"
                            tools:text="₹1,24,500.00" />

                        <TextView
                            android:id="@+id/kpi_invoices_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/fg_dim"
                            android:textSize="10sp"
                            tools:text="14 Invoices" />
                    </LinearLayout>

                    <!-- Taxable Value -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.05"
                            android:text="TAXABLE VALUE"
                            android:textColor="@color/fg_muted"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/kpi_taxable_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/fg"
                            android:textSize="15sp"
                            tools:text="₹1,05,508.00" />

                        <TextView
                            android:id="@+id/kpi_taxable_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/fg_dim"
                            android:textSize="10sp"
                            android:text="Turnover Excl. Tax" />
                    </LinearLayout>
                </LinearLayout>

                <!-- KPI Row 2: Total Tax & Tax Breakdown -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Total Tax Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.05"
                            android:text="TOTAL GST TAX"
                            android:textColor="@color/fg_muted"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/kpi_total_tax"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/status_green"
                            android:textSize="15sp"
                            tools:text="₹18,992.00" />

                        <TextView
                            android:id="@+id/kpi_cgst_sgst"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/fg_dim"
                            android:textSize="10sp"
                            tools:text="CGST: ₹9,496 | SGST: ₹9,496" />
                    </LinearLayout>

                    <!-- Breakdown / IGST Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.05"
                            android:text="IGST &amp; CESS"
                            android:textColor="@color/fg_muted"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/kpi_igst_cess"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/status_orange"
                            android:textSize="15sp"
                            tools:text="₹0.00" />

                        <TextView
                            android:id="@+id/kpi_b2b_b2c_split"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/fg_dim"
                            android:textSize="10sp"
                            tools:text="6 B2B • 8 B2C Retail" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 4. DATA TABLE SECTION -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.05"
                            android:text="INVOICE-WISE REGISTER"
                            android:textColor="@color/fg"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_table_records_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_b2b"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:textColor="@color/material_blue"
                            android:textSize="10.5sp"
                            tools:text="14 Invoices" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="Tap any invoice row to view item details and bill."
                        android:textColor="@color/fg_dim"
                        android:textSize="10.5sp" />

                    <!-- Horizontal Scrollable Table -->
                    <HorizontalScrollView
                        android:id="@+id/horizontal_table_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:scrollbars="horizontal">

                        <TableLayout
                            android:id="@+id/table_sales_register"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:stretchColumns="*" />
                    </HorizontalScrollView>

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/layout_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="32dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:alpha="0.4"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nav_sub_sales_register"
                            app:tint="@color/fg_dim" />

                        <TextView
                            android:id="@+id/tv_empty_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="No sales records found for selected period."
                            android:textColor="@color/fg_muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Navigation Drawer Sidebar -->
    <LinearLayout
        android:id="@+id/drawer_container"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/nav_bg"
        android:clickable="true"
        android:fitsSystemWindows="false"
        android:focusable="true"
        android:orientation="vertical">

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/nav_bg"
            android:fitsSystemWindows="false"
            app:headerLayout="@layout/nav_header"
            app:itemBackground="@drawable/bg_nav_item_selector"
            app:itemHorizontalPadding="24dp"
            app:itemIconPadding="16dp"
            app:itemIconTint="@color/nav_item_icon_tint"
            app:itemTextColor="@color/nav_item_text_color"
            app:itemVerticalPadding="10dp"
            app:menu="@menu/drawer_menu" />

        <LinearLayout
            android:id="@+id/nav_footer_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nav_bg"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="@color/border" />

            <LinearLayout
                android:id="@+id/btn_nav_logout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_nav_logout_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/error_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/logout"
                    android:textColor="@color/error_red"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:alpha="0.6"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/error_red" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
