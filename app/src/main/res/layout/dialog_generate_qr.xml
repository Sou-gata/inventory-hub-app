<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="24dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_tag_sku" />

    <!-- Dialog Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="Generate QR Code"
        android:textColor="@color/fg"
        android:textSize="19sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp"
        android:fontFamily="sans-serif"
        android:text="Select number of copies and batch to encode"
        android:textColor="@color/fg_dim"
        android:textSize="12sp" />

    <!-- Product Summary Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_field_normal"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_gen_qr_product_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/fg"
            android:textSize="14sp"
            tools:text="Paracetamol 500mg Tablet" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_gen_qr_product_sku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_sku"
                android:fontFamily="monospace"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/fg_muted"
                android:textSize="11sp"
                tools:text="#MED-0042" />

            <TextView
                android:id="@+id/tv_gen_qr_product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/accent_teal"
                android:textSize="12sp"
                tools:text="₹ 45.00" />
        </LinearLayout>
    </LinearLayout>

    <!-- Batch Selection Container (Visible only when Batch Mode is ON) -->
    <LinearLayout
        android:id="@+id/container_select_batch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="Select Batch *"
            android:textColor="@color/fg"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_select_batch"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="@color/input_bg"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/accent_teal"
            app:hintEnabled="false">

            <AutoCompleteTextView
                android:id="@+id/actv_select_batch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:hint="Choose batch"
                android:inputType="none"
                android:paddingVertical="12dp"
                android:textColor="@color/fg"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_no_batches_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="No batches available for this product. Default (0) will be used."
            android:textColor="@color/accent_amber"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Number of Copies Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="Number of Copies"
            android:textColor="@color/fg"
            android:textSize="13sp" />

        <!-- Stepper: Minus, Input, Plus -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copies_minus"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="-"
                android:textColor="@color/fg"
                android:textSize="20sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/border" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_copies"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_field_normal"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="4"
                android:text="1"
                android:textColor="@color/fg"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copies_plus"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/fg"
                android:textSize="20sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/border" />
        </LinearLayout>

        <!-- Quick copy pills -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_copy_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tag_sku"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="1"
                android:textColor="@color/fg"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_copy_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tag_sku"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="5"
                android:textColor="@color/fg"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_copy_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tag_sku"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="10"
                android:textColor="@color/fg"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_copy_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tag_sku"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="20"
                android:textColor="@color/fg"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_copy_50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_sku"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="50"
                android:textColor="@color/fg"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dialog Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_generate_qr"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textColor="@color/fg_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_generate_qr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/accent_teal"
            android:text="Generate &amp; Save"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
