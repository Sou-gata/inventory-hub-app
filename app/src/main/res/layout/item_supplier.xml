<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_supplier_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_card_clickable"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Details Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Supplier Name and Status Chip Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_supplier_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/fg"
                android:textSize="16sp"
                tools:text="Apex Logistics &amp; Supplies" />

            <TextView
                android:id="@+id/text_supplier_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_status_chip"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/accent_teal"
                android:textSize="11sp"
                tools:text="Active" />
        </LinearLayout>

        <!-- Contact Person & Phone -->
        <TextView
            android:id="@+id/text_supplier_contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/fg_muted"
            android:textSize="13sp"
            tools:text="Vikram Patel • +91 91234 56789" />

        <!-- City & GST / Subtext -->
        <TextView
            android:id="@+id/text_supplier_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/fg_dim"
            android:textSize="12sp"
            tools:text="Ahmedabad, GJ • GST: 24BBBBB0000B1Z6" />

    </LinearLayout>

    <!-- Actions Column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Status Toggle Action (Deactivate / Activate) -->
        <FrameLayout
            android:id="@+id/btn_toggle_status_supplier"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_button_ripple"
            android:clickable="true"
            android:contentDescription="Toggle Active Status"
            android:focusable="true">

            <ImageView
                android:id="@+id/icon_toggle_status"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_power"
                app:tint="@color/accent_teal" />
        </FrameLayout>

        <!-- Edit Action Button -->
        <FrameLayout
            android:id="@+id/btn_edit_supplier"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_button_ripple_teal"
            android:clickable="true"
            android:contentDescription="Edit Supplier"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_edit" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
