<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    tools:context=".activities.BuyerActivity">

    <!-- Main content container -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header container extending behind status bar -->
        <FrameLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_toolbar">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:navigationIconTint="@color/white"
                app:title="Buyers"
                app:titleTextColor="@color/white" />
        </FrameLayout>

        <!-- Wrap content + FAB in a FrameLayout -->
        <FrameLayout
            android:id="@+id/buyer_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Buyer List Container -->
            <LinearLayout
                android:id="@+id/layout_list_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Search Bar Container -->
                <LinearLayout
                    android:id="@+id/container_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:id="@+id/layout_search_box"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_search_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_search"
                            app:tint="@color/fg_dim" />

                        <EditText
                            android:id="@+id/edit_search_buyer"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:fontFamily="sans-serif"
                            android:hint="Search buyers by name, phone, GST..."
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/fg"
                            android:textColorHint="@color/fg_dim"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/btn_clear_search"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_icon_button_ripple"
                            android:clickable="true"
                            android:contentDescription="Clear search"
                            android:focusable="true"
                            android:padding="6dp"
                            android:src="@drawable/ic_close"
                            android:visibility="gone"
                            app:tint="@color/fg_dim" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Filter Chips Row (All / Active / Deactivated) -->
                <HorizontalScrollView
                    android:id="@+id/scroll_filter_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_filter_all"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="All Buyers"
                            android:textColor="@color/white"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/chip_filter_active"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Active"
                            android:textColor="@color/fg_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/chip_filter_deactive"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Deactivated"
                            android:textColor="@color/fg_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Header Meta Info: Total Count -->
                <LinearLayout
                    android:id="@+id/container_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/text_meta_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:text="ALL BUYERS"
                        android:textColor="@color/fg_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/text_buyer_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_chip"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:textColor="@color/accent_teal"
                        android:textSize="12sp"
                        tools:text="0 Buyers" />
                </LinearLayout>

                <!-- Buyer Content Area (RecyclerView + Search Empty State) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Buyer RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_buyers"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingTop="4dp"
                        android:paddingBottom="88dp" />

                    <!-- Search Empty State -->
                    <LinearLayout
                        android:id="@+id/layout_search_empty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="32dp"
                        android:paddingBottom="64dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/bg_empty_circle">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_search"
                                app:tint="@color/fg_dim" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="No Buyers Found"
                            android:textColor="@color/fg"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/text_search_empty_query"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/fg_muted"
                            android:textSize="13sp"
                            tools:text="No buyers matched your search query." />

                        <FrameLayout
                            android:id="@+id/btn_reset_search"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="20dp"
                            android:background="@drawable/bg_button_ripple"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="sans-serif-medium"
                                android:text="Clear Search"
                                android:textColor="@color/white"
                                android:textSize="13sp" />
                        </FrameLayout>
                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

            <!-- Overall Empty State View -->
            <LinearLayout
                android:id="@+id/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_empty_circle">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_nav_buyer"
                        app:tint="@color/accent_teal" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="No Buyers Yet"
                    android:textColor="@color/fg"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Add your clients, retailers, and wholesale buyers to track orders and dispatch goods seamlessly."
                    android:textColor="@color/fg_muted"
                    android:textSize="14sp" />

                <FrameLayout
                    android:id="@+id/btn_empty_add_buyer"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_button_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="24dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Add Buyer"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Floating Action Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_add_buyer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="20dp"
                android:contentDescription="Add Buyer"
                android:src="@drawable/ic_add"
                app:backgroundTint="@color/accent_teal"
                app:elevation="6dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.InventoryHub.FAB.Rounded"
                app:tint="@color/white" />

        </FrameLayout>

    </LinearLayout>

    <!-- Navigation drawer -->
    <LinearLayout
        android:id="@+id/nav_drawer_container"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/nav_bg"
        android:orientation="vertical">

        <!-- Fixed Header -->
        <include
            android:id="@+id/nav_header_container"
            layout="@layout/nav_header" />

        <!-- Scrollable Navigation Items -->
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/nav_bg"
            app:itemBackground="@drawable/bg_nav_item_selector"
            app:itemHorizontalPadding="24dp"
            app:itemIconPadding="16dp"
            app:itemIconTint="@color/nav_item_icon_tint"
            app:itemTextColor="@color/nav_item_text_color"
            app:itemVerticalPadding="10dp"
            app:menu="@menu/drawer_menu"
            app:subheaderColor="@color/fg_dim"
            app:subheaderInsetStart="24dp" />

        <!-- Bottom Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- Bottom Logout Section -->
        <LinearLayout
            android:id="@+id/nav_footer_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nav_bg"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/btn_nav_logout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_nav_logout_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/logout"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/error_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/logout"
                    android:textColor="@color/error_red"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:alpha="0.6"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/error_red" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>