<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.InventoryHub" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@drawable/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowAnimationStyle">@style/Animation.SlideActivity</item>
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/fg</item>
    </style>

    <style name="Animation.SlideActivity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left_subtle</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left_subtle</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
        <item name="android:taskOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:taskOpenExitAnimation">@anim/slide_out_left_subtle</item>
        <item name="android:taskCloseEnterAnimation">@anim/slide_in_left_subtle</item>
        <item name="android:taskCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="Animation.FadeActivity" parent="@style/Animation.SlideActivity" />

    <style name="Theme.InventoryHub" parent="Base.Theme.InventoryHub" />

    <style name="Theme.InventoryHub.Login" parent="Theme.InventoryHub">
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="ShapeAppearance.InventoryHub.FAB.Rounded" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.InventoryHub.Tab" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>